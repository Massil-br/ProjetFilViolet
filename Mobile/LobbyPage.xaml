<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.LobbyPage"
             BackgroundColor="#1A1A24"
             Title="Menu Principal">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="SALON DE POKER" 
               FontSize="32" 
               FontAttributes="Bold" 
               TextColor="White" 
               HorizontalOptions="Center" />

        <Button Text="REJOINDRE UNE TABLE"
                BackgroundColor="#2E8B57"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="60"
                Margin="0,30,0,0" />

        <Button Text="MON PROFIL"
                BackgroundColor="Transparent"
                BorderColor="#A0A0B0"
                BorderWidth="2"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="55" />
                
        <Button x:Name="LogoutButton"
                Text="SE DÉCONNECTER"
                Clicked="OnLogoutClicked"
                BackgroundColor="Transparent"
                TextColor="#FF6B6B"
                FontAttributes="Bold"
                Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>
