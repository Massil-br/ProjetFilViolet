<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.GamePage"
             Title="Table de Poker"
             BackgroundColor="#16181C"> <!-- Fond sombre -->

    <Grid RowDefinitions="Auto, *, Auto" Padding="15">
        
        <!-- EN-TÊTE : Bouton Quitter et Infos de la table -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0" 
                    Text="QUITTER" 
                    Clicked="OnLeaveClicked" 
                    BackgroundColor="Transparent" 
                    TextColor="#E53935" 
                    FontAttributes="Bold"/>
                    
            <Label Grid.Column="1" 
                   Text="TABLE 1" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>
        </Grid>

        <!-- LA TABLE DE POKER -->
        <Border Grid.Row="1" 
                BackgroundColor="#2E8B57" 
                Stroke="#1B5E20" 
                StrokeThickness="8" 
                Margin="10,40,10,40">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="100" />
            </Border.StrokeShape>
            
            <Grid>
                <Label x:Name="StatusLabel"
                Text="En attente de joueurs..." 
                TextColor="White" 
                Opacity="0.7"
                HorizontalOptions="Center" 
                VerticalOptions="Start" 
                Margin="0,40,0,0"/>


                <!-- Emplacement des cartes au centre (Le Board) -->
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Frame BackgroundColor="White" WidthRequest="50" HeightRequest="75" CornerRadius="5" Padding="0"/>
                    <Frame BackgroundColor="White" WidthRequest="50" HeightRequest="75" CornerRadius="5" Padding="0"/>
                    <Frame BackgroundColor="White" WidthRequest="50" HeightRequest="75" CornerRadius="5" Padding="0"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- BOUTONS D'ACTION (En bas) -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *, *" ColumnSpacing="10" Margin="0,0,0,20">
            <Button Grid.Column="0" 
                    Text="SE COUCHER" 
                    BackgroundColor="#424242" 
                    TextColor="White" 
                    CornerRadius="25" 
                    HeightRequest="50"/>
                    
            <Button Grid.Column="1" 
                    Text="SUIVRE" 
                    BackgroundColor="#2E8B57" 
                    TextColor="White" 
                    CornerRadius="25" 
                    HeightRequest="50"/>
                    
            <Button Grid.Column="2" 
                    Text="RELANCER" 
                    BackgroundColor="#1E88E5" 
                    TextColor="White" 
                    CornerRadius="25" 
                    HeightRequest="50"/>
        </Grid>

    </Grid>
</ContentPage>
