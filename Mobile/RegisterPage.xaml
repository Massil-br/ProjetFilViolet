<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.RegisterPage"
             BackgroundColor="#1A1A24"
             Title="Inscription">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="Créer un compte" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />

        <Entry x:Name="UsernameEntry" 
               Placeholder="Pseudo" 
               TextColor="White"
               PlaceholderColor="#A0A0B0" />

        <Entry x:Name="EmailEntry" 
               Placeholder="Adresse Email" 
               Keyboard="Email" 
               TextColor="White"
               PlaceholderColor="#A0A0B0" />

       <Entry x:Name="ConfirmEmailEntry" 
               Placeholder="Confirmer l'adresse Email" 
               Keyboard="Email" 
               TextColor="White"
               PlaceholderColor="#A0A0B0" />
               
        <Entry x:Name="PasswordEntry" 
               Placeholder="Mot de passe" 
               IsPassword="True" 
               TextColor="White"
               PlaceholderColor="#A0A0B0" />

       <Entry x:Name="ConfirmPasswordEntry" 
               Placeholder="Confirmer le mot de passe" 
               IsPassword="True"
               TextColor="White"
               PlaceholderColor="#A0A0B0" />

        <Button Text="S'INSCRIRE"
                Clicked="OnSubmitRegisterClicked"
                BackgroundColor="Transparent"
                BorderColor="#2E8B57"
                BorderWidth="2"
                TextColor="#2E8B57"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="55"
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>
