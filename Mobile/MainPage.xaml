<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mobile.MainPage"
             BackgroundColor="#1A1A24"> <!-- Fond bleu très sombre / gris -->

    <ScrollView>
        <!-- On centre tout verticalement avec un espacement de 20 entre chaque élément -->
        <VerticalStackLayout Padding="30,0" Spacing="20" VerticalOptions="Center">

            <!-- Espace pour le logo de ton jeu -->
            <!-- Tu pourras ajouter une image poker_logo.png dans le dossier Resources/Images -->
            <Image Source="dotnet_bot.png" 
                   HeightRequest="150"
                   HorizontalOptions="Center" />

            <!-- Titre du jeu -->
            <Label Text="POKER FIL VIOLET"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <!-- Sous-titre -->
            <Label Text="Prêt à faire tapis ?"
                   FontSize="18"
                   TextColor="#A0A0B0"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30" />

            <!-- Bouton Connexion (Style Plein - Vert Casino) -->
            <Button Text="SE CONNECTER"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#2E8B57" 
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="25"
                    HeightRequest="55" />

            <!-- Bouton Inscription (Style Contour) -->
            <Button Text="S'INSCRIRE"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="Transparent"
                    BorderColor="#2E8B57"
                    BorderWidth="2"
                    TextColor="#2E8B57"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="25"
                    HeightRequest="55" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>